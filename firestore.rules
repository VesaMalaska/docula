rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSpaceMember(spaceData) {
      return isAuthenticated() && (
        ('isPublic' in spaceData && spaceData.isPublic == true) ||
        ('userIds' in spaceData && request.auth.uid in spaceData.userIds) ||
        ('ownerId' in spaceData && request.auth.uid == spaceData.ownerId)
      );
    }

    // Helper to Access Space Data safely
    function canAccessSpace(spaceId) {
       let spacePath = /databases/$(database)/documents/spaces/$(spaceId);
       return exists(spacePath) && isSpaceMember(get(spacePath).data);
    }

    match /spaces/{spaceId} {
      allow create: if isAuthenticated();
      allow read: if isSpaceMember(resource.data);
       allow update: if isAuthenticated() && (
          (resource.data.isPublic == true) || // Allow anyone to update if public (specifically for joining)
          request.auth.uid in resource.data.userIds || 
          request.auth.uid == resource.data.ownerId
      );
      allow delete: if isAuthenticated() && (
          request.auth.uid in resource.data.userIds || 
          request.auth.uid == resource.data.ownerId
      );
    }

    match /documents/{documentId} {
      // Allow create if user has access to the target space
      allow create: if isAuthenticated() && canAccessSpace(request.resource.data.spaceId);
      
      // Allow read/write if user has access to the *existing* document's space
      allow read, update, delete: if isAuthenticated() && canAccessSpace(resource.data.spaceId);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
