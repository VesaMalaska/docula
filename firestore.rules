rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSpaceOwner(spaceData) {
      return isAuthenticated() && ('ownerId' in spaceData) && request.auth.uid == spaceData.ownerId;
    }

    function isSpaceMember(spaceData) {
      return isAuthenticated() && ('userIds' in spaceData) && (request.auth.uid in spaceData.userIds);
    }

    function isSpaceActive(spaceData) {
      return !('deletedAt' in spaceData) || spaceData.deletedAt == null;
    }

    function isSpaceReader(spaceData) {
      return isAuthenticated() && (
        ('isPublic' in spaceData && spaceData.isPublic == true) ||
        isSpaceOwner(spaceData) ||
        isSpaceMember(spaceData)
      );
    }

    function isSpaceContributor(spaceData) {
      return isAuthenticated() && (isSpaceOwner(spaceData) || isSpaceMember(spaceData));
    }

    function getSpaceData(spaceId) {
      return get(/databases/$(database)/documents/spaces/$(spaceId)).data;
    }

    function spaceExists(spaceId) {
      return exists(/databases/$(database)/documents/spaces/$(spaceId));
    }

    function canReadSpace(spaceId) {
      return spaceExists(spaceId) && isSpaceActive(getSpaceData(spaceId)) && isSpaceReader(getSpaceData(spaceId));
    }

    function canCleanupDocument(spaceId) {
      return spaceExists(spaceId) &&
        isSpaceOwner(getSpaceData(spaceId)) &&
        !isSpaceActive(getSpaceData(spaceId));
    }

    function canContributeToSpace(spaceId) {
      return spaceExists(spaceId) && isSpaceActive(getSpaceData(spaceId)) && isSpaceContributor(getSpaceData(spaceId));
    }

    function getDocumentData(docId) {
      return get(/databases/$(database)/documents/documents/$(docId)).data;
    }

    function documentExists(docId) {
      return exists(/databases/$(database)/documents/documents/$(docId));
    }

    function isDocumentActive(docData) {
      return (!('deleted' in docData) || docData.deleted == false) &&
        (!('deletedAt' in docData) || docData.deletedAt == null);
    }

    function isDocumentClaimed(docData) {
      return docData != null && ('permanentDeletionClaim' in docData) && docData.permanentDeletionClaim != null;
    }

    function isDocumentClaimedById(docId) {
      return documentExists(docId)
        ? isDocumentClaimed(getDocumentData(docId))
        : (existsAfter(/databases/$(database)/documents/documents/$(docId)) && isDocumentClaimed(getAfter(/databases/$(database)/documents/documents/$(docId)).data));
    }

    function getDocumentSpaceId(docId) {
      return documentExists(docId)
        ? getDocumentData(docId).spaceId
        : getAfter(/databases/$(database)/documents/documents/$(docId)).data.spaceId;
    }

    function isValidChildDocument(data, docId) {
      return data.parentId is string &&
        data.parentId != docId &&
        documentExists(data.parentId) &&
        getDocumentData(data.parentId).spaceId == data.spaceId &&
        isDocumentActive(getDocumentData(data.parentId)) &&
        !isDocumentClaimed(getDocumentData(data.parentId)) &&
        ('path' in getDocumentData(data.parentId)) &&
        (getDocumentData(data.parentId).path is list) &&
        data.path == getDocumentData(data.parentId).path.concat([data.parentId]);
    }

    function isValidDocumentHierarchy(docId) {
      return ('path' in request.resource.data) &&
        (request.resource.data.path is list) &&
        request.resource.data.path.size() <= 3 &&
        ('parentId' in request.resource.data) &&
        (
          (request.resource.data.parentId == null && request.resource.data.path == []) ||
          isValidChildDocument(request.resource.data, docId)
        );
    }

    function isValidSpaceCreate() {
      return isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.userIds is list &&
        request.resource.data.userIds.size() == 1 &&
        request.resource.data.userIds[0] == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.isPublic is bool &&
        (!('description' in request.resource.data) || request.resource.data.description is string) &&
        ('createdAt' in request.resource.data) &&
        (request.resource.data.createdAt is timestamp) &&
        (request.resource.data.createdAt == request.time) &&
        ('updatedAt' in request.resource.data) &&
        (request.resource.data.updatedAt is timestamp) &&
        (request.resource.data.updatedAt == request.time) &&
        (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == null) &&
        (!('deletedBy' in request.resource.data) || request.resource.data.deletedBy == null);
    }

    function retainsOwnership(spaceData) {
      return request.resource.data.ownerId == spaceData.ownerId &&
        ('ownerId' in spaceData) &&
        ('userIds' in spaceData) &&
        ('userIds' in request.resource.data) &&
        (spaceData.userIds is list) &&
        (request.resource.data.userIds is list) &&
        (spaceData.userIds.toSet().size() == spaceData.userIds.size()) &&
        (request.resource.data.userIds.toSet().size() == request.resource.data.userIds.size()) &&
        (spaceData.ownerId in spaceData.userIds) &&
        (spaceData.ownerId in request.resource.data.userIds);
    }

    function isOwnerRemoval(spaceData, diff) {
      return isSpaceActive(spaceData) &&
        isSpaceOwner(spaceData) &&
        diff.affectedKeys().hasOnly(['userIds', 'updatedAt']) &&
        diff.affectedKeys().hasAny(['userIds']) &&
        request.resource.data.userIds.size() == spaceData.userIds.size() - 1 &&
        request.resource.data.userIds.removeAll(spaceData.userIds).size() == 0 &&
        spaceData.userIds.removeAll(request.resource.data.userIds).size() == 1 &&
        spaceData.userIds.removeAll(request.resource.data.userIds)[0] != spaceData.ownerId;
    }

    function isMemberDeparture(spaceData, diff) {
      return isSpaceActive(spaceData) &&
        isSpaceMember(spaceData) && !isSpaceOwner(spaceData) &&
        diff.affectedKeys().hasOnly(['userIds', 'updatedAt']) &&
        diff.affectedKeys().hasAny(['userIds']) &&
        request.resource.data.userIds.size() == spaceData.userIds.size() - 1 &&
        request.resource.data.userIds.removeAll(spaceData.userIds).size() == 0 &&
        spaceData.userIds.removeAll(request.resource.data.userIds) == [request.auth.uid];
    }

    function isAddMember(spaceData, diff) {
      return isSpaceActive(spaceData) &&
        isSpaceContributor(spaceData) &&
        diff.affectedKeys().hasOnly(['userIds', 'updatedAt']) &&
        diff.affectedKeys().hasAny(['userIds']) &&
        request.resource.data.userIds.size() == spaceData.userIds.size() + 1 &&
        request.resource.data.userIds.removeAll(spaceData.userIds).size() == 1 &&
        spaceData.userIds.removeAll(request.resource.data.userIds).size() == 0;
    }

    function isJoinPublic(spaceData, diff) {
      return isSpaceActive(spaceData) &&
        ('isPublic' in spaceData && spaceData.isPublic == true) &&
        !isSpaceContributor(spaceData) &&
        diff.affectedKeys().hasOnly(['userIds', 'updatedAt']) &&
        diff.affectedKeys().hasAny(['userIds']) &&
        request.resource.data.userIds.size() == spaceData.userIds.size() + 1 &&
        request.resource.data.userIds.removeAll(spaceData.userIds) == [request.auth.uid] &&
        spaceData.userIds.removeAll(request.resource.data.userIds).size() == 0;
    }

    function isRename(spaceData, diff) {
      return isSpaceActive(spaceData) &&
        isSpaceContributor(spaceData) &&
        diff.affectedKeys().hasOnly(['name', 'updatedAt']) &&
        diff.affectedKeys().hasAny(['name']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
    }

    function isSoftDelete(spaceData, diff) {
      return isSpaceActive(spaceData) &&
        isSpaceOwner(spaceData) &&
        diff.affectedKeys().hasOnly(['deletedAt', 'deletedBy', 'updatedAt']) &&
        diff.affectedKeys().hasAny(['deletedAt', 'deletedBy']) &&
        request.resource.data.deletedAt != null &&
        request.resource.data.deletedBy == request.auth.uid;
    }

    function isRestore(spaceData, diff) {
      return !isSpaceActive(spaceData) &&
        isSpaceOwner(spaceData) &&
        diff.affectedKeys().hasOnly(['deletedAt', 'deletedBy', 'updatedAt']) &&
        diff.affectedKeys().hasAny(['deletedAt', 'deletedBy']) &&
        request.resource.data.deletedAt == null &&
        request.resource.data.deletedBy == null;
    }

    function isValidSpaceUpdate(spaceData) {
      let diff = request.resource.data.diff(spaceData);
      return retainsOwnership(spaceData) && (
        isOwnerRemoval(spaceData, diff) ||
        isMemberDeparture(spaceData, diff) ||
        isAddMember(spaceData, diff) ||
        isJoinPublic(spaceData, diff) ||
        isRename(spaceData, diff) ||
        isSoftDelete(spaceData, diff) ||
        isRestore(spaceData, diff)
      );
    }

    match /spaces/{spaceId} {
      allow create: if isValidSpaceCreate();
      allow read: if isSpaceReader(resource.data);
      allow update: if isAuthenticated() && isValidSpaceUpdate(resource.data);
      allow delete: if isAuthenticated() && isSpaceOwner(resource.data) && !isSpaceActive(resource.data);
    }

    match /documents/{documentId} {
      // Allow create if caller is a contributor of the target space, hierarchy is valid, and not claimed
      allow create: if isAuthenticated() &&
        request.resource.data.spaceId is string &&
        canContributeToSpace(request.resource.data.spaceId) &&
        !isDocumentClaimed(request.resource.data) &&
        isValidDocumentHierarchy(documentId);
      
      // Allow read if caller has read access to document's active space, or owner during cleanup
      allow read: if isAuthenticated() && (
        canReadSpace(resource.data.spaceId) ||
        canCleanupDocument(resource.data.spaceId)
      );
      
      // Disallow direct client permanent deletion in active spaces.
      // Permanent single-document deletion is handled server-authoritatively via Admin SDK.
      // Direct client deletion is only allowed for space owner during soft-deleted space cleanup.
      allow delete: if isAuthenticated() && canCleanupDocument(resource.data.spaceId);

      // Allow update if caller is a contributor, spaceId is unchanged, document is not claimed,
      // client does not alter permanentDeletionClaim, and hierarchy is valid if parentId or path is modified
      allow update: if isAuthenticated() &&
        request.resource.data.spaceId == resource.data.spaceId &&
        canContributeToSpace(resource.data.spaceId) &&
        !isDocumentClaimed(resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permanentDeletionClaim']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['parentId', 'path']) ||
          isValidDocumentHierarchy(documentId)
        );

      match /content/{contentId} {
         allow read: if isAuthenticated() && (
           canReadSpace(getDocumentSpaceId(documentId)) ||
           canCleanupDocument(getDocumentSpaceId(documentId))
         );
         allow create, update: if isAuthenticated() &&
           canContributeToSpace(getDocumentSpaceId(documentId)) &&
           !isDocumentClaimedById(documentId);
         // Disallow direct client permanent deletion in active spaces.
         // Direct client deletion is only allowed for space owner during soft-deleted space cleanup.
         allow delete: if isAuthenticated() && canCleanupDocument(getDocumentSpaceId(documentId));
      }
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /user_settings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
