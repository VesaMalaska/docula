rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSpaceMember(spaceData) {
      return isAuthenticated() && (
        spaceData.get('isPublic', false) == true ||
        (spaceData.get('userIds', []).hasAny([request.auth.uid])) ||
        spaceData.get('ownerId', '') == request.auth.uid
      );
    }

    // Helper to Access Space Data safely
    function canAccessSpace(spaceId) {
       let spacePath = /databases/$(database)/documents/spaces/$(spaceId);
       return exists(spacePath) && isSpaceMember(get(spacePath).data);
    }

    match /spaces/{spaceId} {
      allow create: if isAuthenticated();
      // Allow reading if doc doesn't exist (returns 404 to client) OR if user is member
      allow read: if resource == null || isSpaceMember(resource.data);
      allow update, delete: if isAuthenticated() && (
          request.auth.uid in resource.data.userIds || 
          request.auth.uid == resource.data.ownerId
      );
    }

    match /documents/{documentId} {
      // Allow create if user has access to the target space
      allow create: if isAuthenticated() && canAccessSpace(request.resource.data.spaceId);
      
      // Allow read/write if user has access to the *existing* document's space
      allow read, update, delete: if isAuthenticated() && canAccessSpace(resource.data.spaceId);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
